# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
android/build/

# Golden test failure images (generated by flutter_test on golden mismatch — never commit)
test/**/failures/

# Beautica — secrets and signing material (never commit).
**/google-services.json
**/GoogleService-Info.plist
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
build/symbols/
.env
.env.*

# Generated Dart sources — Phase 1+ codegen, regenerate via build_runner.
**/*.g.dart
**/*.freezed.dart
**/*.gen.dart

# Config file written by the openapi_generator_cli Dart pub tool — only
# needed in the working dir at generation time; never commit it.
openapi_generator_config.json

# Exception: api/ is the committed OpenAPI-generated package (moved from lib/api/
# in Phase 3.2 to eliminate the Dart package-path overlap that caused the CFE
# "language version override must match library and parts" error when importing
# beautica_api from root-project tests).
# The *.g.dart files inside it are generated by built_value_generator and must
# be committed alongside the other generated sources so CI can compile offline.
!api/**/*.g.dart
!api/lib/**
!api/pubspec.yaml
!api/pubspec.lock
!api/analysis_options.yaml
!api/.dart_tool/package_config.json

# Riverpod codegen output for api_client_provider — lives in lib/core/network/
# but is a hand-authored provider (not a feature codegen file), so it must be
# committed like other *.g.dart Riverpod outputs.
!lib/core/network/api_client_provider.g.dart

# Generated localization (`flutter gen-l10n` output).
lib/l10n/app_localizations*.dart

