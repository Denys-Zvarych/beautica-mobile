#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Beautica — secrets and signing material (never commit).
**/google-services.json
**/GoogleService-Info.plist
android/key.properties
android/app/upload-keystore.jks
android/app/*.jks
build/symbols/
.env
.env.*

# Generated Dart sources — Phase 1+ codegen, regenerate via build_runner.
**/*.g.dart
**/*.freezed.dart
**/*.gen.dart

# Generated localization (`flutter gen-l10n` output).
lib/l10n/app_localizations*.dart

