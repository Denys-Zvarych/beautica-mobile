<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration for Beautica Mobile — BASE (phase 408).

    HTTPS-only for every host, system trust store, no user CAs. This file
    deliberately carries NO <domain-config>: the per-environment API host and its
    ISRG anchors live in the flavor source sets, which override this file:

        src/staging/res/xml/network_security_config.xml  -> beautica-backend-staging.up.railway.app
        src/prod/res/xml/network_security_config.xml     -> api.beautica.app

    The media hosts (media.beautica.app — Cloudflare-proxied, Google Trust Services
    chain; *.r2.dev — not ours) are DELIBERATELY not pinned anywhere: media uses the
    system trust store (see beautica_image.dart / media_config.dart).

    Resource precedence is buildType > flavor > main, so src/debug's config (which adds
    cleartext for local dev addresses) still wins for debug builds of either flavor.

    Trust anchors in the flavor files: ISRG Root X1 (to 2035) AND ISRG Root X2
    (to 2040), same bytes as assets/certs/ (loaded by lib/core/network/dio_provider.dart
    — keep in lockstep). Verified live 2026-10-25:
        api.beautica.app (prod): Let's Encrypt YR2 <- ISRG Root YR <- cross-signed by ISRG Root X1
        beautica-backend-staging.up.railway.app: Let's Encrypt YE2 <- ISRG Root YE <- cross-signed by ISRG Root X2
    Both roots are kept in both files: widening only adds chains an X1-only anchor
    already accepted plus the shortened (cross-sign dropped) ones; dropping either
    would fail closed on a CA-rotation. NOT an SPKI pin, deliberately — see the
    "why root and not intermediate" analysis in dio_provider.dart. Never add leaf or
    intermediate pins.
-->
<network-security-config>
    <!-- HTTPS only, no user CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug builds: also trust user-installed CA certificates (e.g. Charles, mitmproxy).
         Cleartext dev addresses (10.0.2.2, 192.168.56.101, localhost) are NOT listed here —
         they live in src/debug/res/xml/network_security_config.xml which overrides this file
         for debug/debuggable builds only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
