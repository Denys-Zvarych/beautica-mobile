<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Phase 071: native uCrop crop screen. Palette-matched (base toolbar,
         mocha widgets); colours are also set per-crop from BrandColors in
         ImagePickGatewayImpl. Parent MUST be an AppCompat theme (uCrop). -->
    <style name="Ucrop.Velvet" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#E6DDD0</item>
        <item name="colorPrimaryDark">#E6DDD0</item>
        <item name="colorAccent">#B89A7A</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- targetSdk 35 enforces edge-to-edge: opt out so the uCrop toolbar is
             not drawn under the status bar. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
