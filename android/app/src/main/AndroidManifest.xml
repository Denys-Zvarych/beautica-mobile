<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Required for all network calls in all build variants (debug, profile, release). -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <!-- Phase 066: Android 13+ runtime notification permission (requested in phase 067). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Phase 409 D10: no ad SDK and Firebase analytics collection is off, so the
         AD_ID permission a dependency may merge in is stripped (Play Console:
         "does not use advertising ID"). The full merged release set is pinned by
         android/release-permissions.allow and checked by scripts/verify_release_aab.sh. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove"/>
    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <!--
                Phase 17.5 — REQUIRED for App Link / deep-link routing into go_router.
                Without this, an approved https ACTION_VIEW intent reaching MainActivity
                is NOT forwarded to Flutter's RouteInformationProvider, so go_router never
                navigates to /invite/accept. Flutter's automatic deep-linking hands the
                launch/onNewIntent intent URL to the framework, which go_router
                (MaterialApp.router) consumes via the default RouteInformationProvider.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Android App Links for the security-token deep-link (MS-MEDIUM-1, Phase 2.20
                audit). Scoped to /invite/accept only, on the per-flavor host
                ${appLinkHost} (phase 408: prod beautica.app, staging staging.beautica.app —
                see productFlavors in app/build.gradle.kts).
                android:autoVerify="true" prevents a competing app from registering the same
                URL scheme and intercepting the single-use invite token from an emailed link.

                IMPORTANT — the autoVerify handshake REQUIRES a
                /.well-known/assetlinks.json file on the flavor's host. Prod: the website
                serves https://beautica.app/.well-known/assetlinks.json (filled once the Play
                signing SHA-256 exists). Staging has no frontend host yet, so its link stays
                unverified (harmless: it can never claim prod links). Until verified, these
                links open as ordinary browser links; the filter is safe to ship.
                Action item for backend-dev: publish assetlinks.json (Phase 2.20 backlog).

                mobile-security MEDIUM (OTP task): the /reset-password autoVerify intent-filter
                that used to sit here was a holdover from the retired emailed-link `?token=`
                flow. It was REMOVED because android:pathPrefix matches by prefix, so it also
                claimed /reset-password/otp (the unauthenticated OTP-entry screen) as a live
                exported deep-link surface — even though the OTP flow (Beautica OTP task Phase
                B3/B4) only ever reads `GoRouterState.extra` from in-app navigation and never a
                URL. There is no more emailed link to deep-link from, so this route needs no
                external linkability at all.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="${appLinkHost}"
                    android:pathPrefix="/invite/accept" />
            </intent-filter>
        </activity>
        <!-- Phase 071: uCrop crop screen (image_cropper). No storage/camera
             permission is declared anywhere: the Photo Picker and the camera
             intent need none. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Ucrop.Velvet"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles"/>

        <!--
            MP-STARTUP-FIREBASE: Disable Firebase Messaging auto-init on cold start.

            Root cause: Firebase ships a ContentProvider (FirebaseInitProvider, priority 100)
            that runs BEFORE Application.onCreate() and calls FirebaseApp.initializeApp().
            On first cold start on Samsung/Xiaomi/older devices this triggers Keystore operations
            for FCM token generation and can block process startup for 3–10 seconds.

            firebase_messaging auto-init stays disabled (phase 066, D5): Firebase is
            initialised explicitly from Dart (core/push/firebase_bootstrap.dart) and the
            FCM token is fetched explicitly only after login (phase 067). Do not flip
            these to "true" without re-measuring cold start on a cold device.

            The merged FirebaseInitProvider is deliberately KEPT (not removed via tools:node):
            firebase_messaging's background receiver needs FirebaseApp initialised natively in
            a cold process (phase 068 background messages).
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false"/>
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false"/>

        <!--
            FCM small icon + tint for notifications FCM renders itself (app in background
            or killed). Without these FCM falls back to the opaque launcher icon, which
            Android masks to a white square. ic_stat_beautica is a white-on-transparent
            silhouette; both resources are pinned against shrinking in res/raw/keep.xml
            because nothing in code references them (only this manifest).
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_beautica"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <!--
            Android 11+ (API 30) package visibility for url_launcher. Without this
            declaration, launchUrl() of an https ACTION_VIEW intent (the Instagram
            profile link on the master profile screen) silently fails because the
            calling package cannot "see" any browser/Instagram activity that can
            handle https. Scheme-only data filter — no host — so any validated
            https URL can resolve to the user's default handler.
        -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
        <!--
            Android 11+ (API 30) package visibility for add_2_calendar. Without
            this declaration, the ACTION_INSERT intent that opens the calendar's
            "new event" sheet (the «Додати в календар» action on the booking
            detail / success screens and the home-hub next-appointment card)
            cannot "see" any calendar app and throws ActivityNotFoundException.
            See the add_2_calendar README's Android setup.
        -->
        <intent>
            <action
                android:name="android.intent.action.INSERT"/>
            <data
                android:mimeType="vnd.android.cursor.item/event"/>
        </intent>
        <!--
            Phase 417 — tap-to-call on «Деталі запису» (guest phone). launchUrl
            of a tel: URI is not gated on canLaunchUrl, but Android 11+ package
            visibility still needs the dialer to be queryable.
        -->
        <intent>
            <action
                android:name="android.intent.action.DIAL"/>
            <data
                android:scheme="tel"/>
        </intent>
    </queries>
</manifest>