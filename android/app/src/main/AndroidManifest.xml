<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required for all network calls in all build variants (debug, profile, release). -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <application
        android:label="Beautica"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <!--
                Phase 17.5 — REQUIRED for App Link / deep-link routing into go_router.
                Without this, an approved https ACTION_VIEW intent reaching MainActivity
                is NOT forwarded to Flutter's RouteInformationProvider, so go_router never
                navigates to /reset-password. Flutter's automatic deep-linking hands the
                launch/onNewIntent intent URL to the framework, which go_router
                (MaterialApp.router) consumes via the default RouteInformationProvider.
            -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="true"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
                Android App Links for the security-token deep-link (MS-MEDIUM-1, Phase 2.20
                audit). Scoped to /invite/accept only on the production Railway domain.
                android:autoVerify="true" prevents a competing app from registering the same
                URL scheme and intercepting the single-use invite token from an emailed link.

                IMPORTANT — the autoVerify handshake REQUIRES a
                /.well-known/assetlinks.json file to be published on the production domain
                (https://beautica-backend-production.up.railway.app/.well-known/assetlinks.json).
                Until the backend team publishes that file, these links will open as ordinary
                browser links rather than directly in the app; this intent-filter is safe to
                ship now and causes no regression for users.
                Action item for backend-dev: publish assetlinks.json (Phase 2.20 backlog).

                mobile-security MEDIUM (OTP task): the /reset-password autoVerify intent-filter
                that used to sit here was a holdover from the retired emailed-link `?token=`
                flow. It was REMOVED because android:pathPrefix matches by prefix, so it also
                claimed /reset-password/otp (the unauthenticated OTP-entry screen) as a live
                exported deep-link surface — even though the OTP flow (Beautica OTP task Phase
                B3/B4) only ever reads `GoRouterState.extra` from in-app navigation and never a
                URL. There is no more emailed link to deep-link from, so this route needs no
                external linkability at all.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="beautica-backend-production.up.railway.app"
                    android:pathPrefix="/invite/accept" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles"/>

        <!--
            MP-STARTUP-FIREBASE: Disable Firebase Messaging auto-init on cold start.

            Root cause: Firebase ships a ContentProvider (FirebaseInitProvider, priority 100)
            that runs BEFORE Application.onCreate() and calls FirebaseApp.initializeApp().
            On first cold start on Samsung/Xiaomi/older devices this triggers Keystore operations
            for FCM token generation and can block process startup for 3–10 seconds.

            firebase_messaging auto-init is disabled here because:
              1. Firebase push (Phase 8.1) is deferred — FIREBASE_ENABLED=false on Railway.
              2. The app does not yet call Firebase.initializeApp() in Dart code.
              3. Enabling auto-init without calling Firebase.initializeApp() in Dart means the
                 native SDK initializes but the Dart side is not configured, causing a
                 PlatformException on first FirebaseMessaging.instance usage anyway.

            To re-enable when Phase 8.1 ships:
              1. Remove or flip these two meta-data entries to "true".
              2. Add Firebase.initializeApp() in main() (or a deferred post-login init).
              3. Verify cold-start time stays under 2 s on a cold Pixel 6.
        -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false"/>
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action
                android:name="android.intent.action.PROCESS_TEXT"/>
            <data
                android:mimeType="text/plain"/>
        </intent>
        <!--
            Android 11+ (API 30) package visibility for url_launcher. Without this
            declaration, launchUrl() of an https ACTION_VIEW intent (the Instagram
            profile link on the master profile screen) silently fails because the
            calling package cannot "see" any browser/Instagram activity that can
            handle https. Scheme-only data filter — no host — so any validated
            https URL can resolve to the user's default handler.
        -->
        <intent>
            <action
                android:name="android.intent.action.VIEW"/>
            <data
                android:scheme="https"/>
        </intent>
    </queries>
</manifest>