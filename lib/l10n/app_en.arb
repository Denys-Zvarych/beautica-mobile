  "@errServer": {
    "description": "Error message shown when a 5xx server error occurs."
  },
  "errUnknown": "Something went wrong. Please try again.",
  "@errUnknown": {
    "description": "Fallback error message for unexpected failures."
  },
  "errConflict": "This time slot is no longer available. Please choose another.",
  "@errConflict": {
    "description": "Error message shown when a booking create/reschedule returns HTTP 409 because the requested slot is no longer available (ConflictFailure)."
  },
  "errMasterBookingDuplicate": "This booking has already been created",
  "@errMasterBookingDuplicate": {
    "description": "Error message shown when the master \"Новий запис\" wizard's submit returns HTTP 409 (MasterBookingDuplicateFailure) — the create path has no idempotency key because the overlap check already makes a duplicate visit impossible to persist, so a 409 here almost always means the master's own double-tap/retry already succeeded, not that the slot was taken by someone else."
  },
  "bookingErrClientConflict": "You already have a booking at this time: {serviceName}, {masterName}, {window}",
  "@bookingErrClientConflict": {
    "description": "Error message shown when a booking create/reschedule returns HTTP 409 with data.code == CLIENT_BOOKING_CONFLICT — the client already has an overlapping booking of their own (ClientBookingConflictFailure).",
    "placeholders": {
      "serviceName": {
        "type": "String",
        "example": "Classic manicure"
      },
      "masterName": {
        "type": "String",
        "example": "Olena Koval"
      },
      "window": {
        "type": "String",
        "example": "Tue, 15 Jul · 14:00–15:30"
      }
    }
  },
  "bookingErrRateLimited": "Too many booking attempts. Please wait a few seconds and try again.",
  "@bookingErrRateLimited": {
    "description": "Error message shown when POST /bookings or PATCH /bookings/{id}/reschedule returns HTTP 429 (per-user booking-write rate limit)."
  },
  "bookingErrMasterNotPermitted": "You don't have permission to create this booking.",
  "@bookingErrMasterNotPermitted": {
    "description": "Error message shown when POST /api/v1/masters/{masterId}/bookings returns HTTP 403 (backend Phase 22.4 @authz.canBookForMaster) — the caller may not book this master (wrong salon, not the independent master's own profile, read-only SALON_MASTER caller) OR the master id is unknown/inactive (deliberately collapsed into the same 403 as a probe defence). Surfaced via MasterBookingNotPermittedFailure.userMessage — must never imply the master was not found, which would leak that distinction."
  },
  "bookingErrorAlreadyElapsed": "This booking's time has already passed.",
  "@bookingErrorAlreadyElapsed": {
    "description": "Error message shown when PATCH /bookings/{id}/reschedule or /cancel returns HTTP 409 with data.code == BOOKING_ALREADY_ELAPSED (backend 952e441): the booking's slot is already past the server clock, so it can no longer be rescheduled or cancelled. Surfaced via BookingAlreadyElapsedFailure.userMessage on a stale-screen / clock-rollback tap."
  },
  "bookingErrorProviderDeclineWindowClosed": "This booking has already started — it can no longer be declined.",
  "@bookingErrorProviderDeclineWindowClosed": {
    "description": "Error message shown when PATCH /bookings/{id}/decline returns HTTP 409 (backend Phase 27.1 BookingTemporalGuard.assertFutureForProviderCancel — the booking's startsAt is no longer strictly in the future). Surfaced via ProviderDeclineWindowClosedFailure.userMessage on a stale-screen / clock-rollback tap."
  },
  "bookingErrorProviderCompleteNotStarted": "This booking hasn't started yet — it can't be completed.",
  "@bookingErrorProviderCompleteNotStarted": {
    "description": "Error message shown when PATCH /bookings/{id}/complete returns HTTP 409 (backend Phase 27.1 BookingTemporalGuard.assertElapsedForComplete — the booking's startsAt is still in the future). Surfaced via ProviderCompleteNotStartedFailure.userMessage on a stale-screen / clock-rollback tap."
  },
  "bookingErrDuplicateService": "A service can't be added twice. Remove the duplicate and try again.",
  "@bookingErrDuplicateService": {
    "description": "Error message shown when POST /appointments returns HTTP 409 with data.code == DUPLICATE_SERVICE — the multi-service visit named the same service twice. Surfaced via DuplicateServiceFailure.userMessage (the selection UI dedupes up-front, so this is a backstop)."
  },
  "bookingMaxServicesReached": "You can pick at most {count} services per visit.",
  "@bookingMaxServicesReached": {
    "description": "SnackBar shown when the client tries to add more than MAX_SERVICES_PER_VISIT services to one booking visit in the service selector.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
